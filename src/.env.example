# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-05-01-preview
AZURE_DEPLOYMENT_NAME=gpt-4o

# --- Embeddings (used by MCP/agent_server.py) ---
AZURE_EMBED_ENDPOINT=
AZURE_DEPLOYMENT_NAME_EMBED=text-embedding-3-large
AZURE_API_VERSION_EMBED=2024-02-01
EMBED_DIM=3072

# --- OpenSearch index name for POIs ---
POI_INDEX=tourism-data-v7

# --- OTP2 (required in this stack) ---
OTP_URL=http://otp:8080/otp/routers/default/index/graphql

# --- BayernCloud fetching (for ingestion) ---
BAYERNCLOUD_API_KEY=
BAYERNCLOUD_API_BASE_URL=
BAYERNCLOUD_DATA_DIR=/data/bayerncloud
BAYERNCLOUD_FILE_PATTERN=*.json
BAYERNCLOUD_PAGE_SIZE=100
